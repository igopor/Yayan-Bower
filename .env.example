# 复制为 .env 后按需修改：cp .env.example .env
DATABASE_URL="file:./dev.db"
PORT=3000

# ⚠️ 上线前必须换成随机值，别用这个占位符。
#    它是登录凭证（JWT）的签名密钥：知道它的人可以自己签一个 token 冒充任意用户，
#    不需要手机号、不需要验证码。本仓库是公开的，所以这个值等于人人可见。
#    生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#    换掉后已发出的 token 全部失效，用户重新登录一次即可。
JWT_SECRET="CHANGE-ME-run-openssl-rand-hex-32"

JWT_EXPIRES_IN="7d"

# 短信通道：mock=不真发（验证码固定填 SMS_MOCK_CODE，仅开发用）；aliyun=真实短信
SMS_PROVIDER="mock"
SMS_MOCK_CODE="123456"

# ── AI 小结（家校反馈页的 AI 卡片，可选）─────────────────
# off   = 关闭，报告页不显示 AI 卡片
# mock  = 演示通道，不联网不花钱，用本地规则模拟一段小结
# openai= 调用 OpenAI 兼容接口（DeepSeek / 通义 / 智谱 / Kimi / 本地 Ollama 均可）
AI_PROVIDER="mock"

# ⚠️ API key 只放在这个文件里，**不要写进代码、不要提交、不要下发到前端**。
#    本仓库公开，任何提交上去的 key 都视为已泄露。
#    前端只调用本站 /api/report/ai-summary，由服务端代为请求模型厂商。
#    用 openai 通道时才需要填；填了记得把 .env 排除在版本控制之外（默认已排除）。
AI_API_KEY=""
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"
AI_TIMEOUT_MS=8000

# ── 语言测评（首页第 5 张卡，可选）─────────────────────
# 复用上面的 AI_PROVIDER：off 时首页入口置灰，mock 走本地规则，openai 走真实调用。
# 每天次数上限：mock 通道会自动放宽到至少 50 次（不花钱，别让演示被次数卡住），
# 真实调用按这个值算。
ASSESS_DAILY_LIMIT=10
# 输入字数上限。下限固定 30 字，不做配置。
ASSESS_MAX_CHARS=300
